<?xml version="1.0"?>
<sdf version="1.9">
  <world name="door_world">

    <!-- ===== 物理・レンダリング設定 ===== -->
    <physics name="default_physics" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="libgz-sim-physics-system.so"
            name="gz::sim::systems::Physics"/>
    <plugin filename="libgz-sim-user-commands-system.so"
            name="gz::sim::systems::UserCommands"/>
    <plugin filename="libgz-sim-scene-broadcaster-system.so"
            name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="libgz-sim-sensors-system.so"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="libgz-sim-imu-system.so"
            name="gz::sim::systems::Imu"/>

    <!-- ===== 環境光 ===== -->
    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- ===== 床 ===== -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
          <surface><friction><ode><mu>1</mu><mu2>1</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
          <material>
            <ambient>0.6 0.6 0.6 1</ambient>
            <diffuse>0.6 0.6 0.6 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ===== 部屋の壁 ===== -->
    <!-- 壁の厚さ0.15m、高さ2.5m、部屋サイズ約6x5m -->

    <!-- 北壁（奥） -->
    <model name="wall_north">
      <static>true</static>
      <pose>0 2.5 1.25 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>6.3 0.15 2.5</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>6.3 0.15 2.5</size></box></geometry>
          <material><ambient>0.9 0.9 0.85 1</ambient><diffuse>0.9 0.9 0.85 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- 南壁（手前） -->
    <model name="wall_south">
      <static>true</static>
      <pose>0 -2.5 1.25 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>6.3 0.15 2.5</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>6.3 0.15 2.5</size></box></geometry>
          <material><ambient>0.9 0.9 0.85 1</ambient><diffuse>0.9 0.9 0.85 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- 西壁（左） -->
    <model name="wall_west">
      <static>true</static>
      <pose>-3.0 0 1.25 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.15 5.0 2.5</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>0.15 5.0 2.5</size></box></geometry>
          <material><ambient>0.9 0.9 0.85 1</ambient><diffuse>0.9 0.9 0.85 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- 東壁（右）：ドアを挟んで2分割 -->
    <!-- 東壁 上側（ドアより北） -->
    <model name="wall_east_north">
      <static>true</static>
      <!-- ドア開口: Y=0.5〜1.5（幅1.0m）、壁はY=1.5〜2.5 → 中心Y=2.0、長さ1.0 -->
      <pose>3.0 2.0 1.25 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.15 1.0 2.5</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>0.15 1.0 2.5</size></box></geometry>
          <material><ambient>0.9 0.9 0.85 1</ambient><diffuse>0.9 0.9 0.85 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- 東壁 下側（ドアより南） -->
    <model name="wall_east_south">
      <static>true</static>
      <!-- ドア開口: Y=0.5〜1.5、壁はY=-2.5〜0.5 → 中心Y=-1.0、長さ3.0 -->
      <pose>3.0 -1.0 1.25 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.15 3.0 2.5</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>0.15 3.0 2.5</size></box></geometry>
          <material><ambient>0.9 0.9 0.85 1</ambient><diffuse>0.9 0.9 0.85 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ===== ドア ===== -->
    <!--
      ドア枠: X=3.0, Y=0.5〜1.5（幅1.0m）
      ヒンジ: Y=0.5側（南端）
      ドア板: 幅0.95m、厚さ0.05m
      初期状態: 閉（X=3.0方向に平行）
    -->
    <model name="door">
      <pose>3.0 0.5 0 0 0 0</pose>

      <!-- ドア枠（上部のみ、視覚的） -->
      <link name="door_frame">
        <static>false</static>
        <!-- 固定 -->
      </link>

      <!-- ドア板 -->
      <link name="door_leaf">
        <!-- ヒンジ点(0,0)からY方向に0.475m伸びる板 -->
        <pose>0 0.475 1.105 0 0 0</pose>
        <collision name="col">
          <geometry><box><size>0.05 0.95 2.19</size></box></geometry>
        </collision>
        <visual name="vis">
          <geometry><box><size>0.05 0.95 2.19</size></box></geometry>
          <material>
            <ambient>0.6 0.4 0.2 1</ambient>
            <diffuse>0.6 0.4 0.2 1</diffuse>
          </material>
        </visual>
        <inertial>
          <mass>8.0</mass>
          <inertia>
            <ixx>3.5</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>0.02</iyy><iyz>0</iyz>
            <izz>3.5</izz>
          </inertia>
        </inertial>
      </link>

      <!-- ヒンジジョイント（Z軸回り） -->
      <joint name="door_hinge" type="revolute">
        <parent>door_frame</parent>
        <child>door_leaf</child>
        <pose>0 0 0 0 0 0</pose>
        <axis>
          <xyz>0 0 1</xyz>
          <limit>
            <lower>0</lower>
            <upper>1.5708</upper>  <!-- 0〜90度 -->
            <effort>100</effort>
            <velocity>1.0</velocity>
          </limit>
          <dynamics>
            <damping>2.0</damping>
            <friction>1.0</friction>
          </dynamics>
        </axis>
      </joint>

    </model>

    <!-- ===== 内壁（廊下仕切り）：ドア検出を面白くするため ===== -->
    <model name="inner_wall">
      <static>true</static>
      <pose>0 0 1.25 0 0 0</pose>
      <link name="link">
        <!-- X方向に伸びる仕切り壁、中央にもう1つのドア開口 -->
        <collision name="col_left">
          <pose>-1.5 0 0 0 0 0</pose>
          <geometry><box><size>1.5 0.15 2.5</size></box></geometry>
        </collision>
        <visual name="vis_left">
          <pose>-1.5 0 0 0 0 0</pose>
          <geometry><box><size>1.5 0.15 2.5</size></box></geometry>
          <material><ambient>0.85 0.85 0.8 1</ambient><diffuse>0.85 0.85 0.8 1</diffuse></material>
        </visual>
        <collision name="col_right">
          <pose>1.5 0 0 0 0 0</pose>
          <geometry><box><size>1.5 0.15 2.5</size></box></geometry>
        </collision>
        <visual name="vis_right">
          <pose>1.5 0 0 0 0 0</pose>
          <geometry><box><size>1.5 0.15 2.5</size></box></geometry>
          <material><ambient>0.85 0.85 0.8 1</ambient><diffuse>0.85 0.85 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
