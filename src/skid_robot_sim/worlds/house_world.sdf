    <model name="entrance_door">
      <pose>0.0 4.0 0 0 0 3.14159</pose>
      <link name="door_frame">
        <inertial>
          <mass>1000.0</mass>
          <inertia>
            <ixx>100.0</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>100.0</iyy><iyz>0</iyz>
            <izz>100.0</izz>
          </inertia>
        </inertial>
      </link>
      <joint name="door_frame_fixed" type="fixed">
        <parent>world</parent>
        <child>door_frame</child>
      </joint>
      <link name="door_leaf">
        <pose>0 0.5 1.105 0 0 0</pose>
        <collision name="col">
          <geometry><box><size>0.05 0.95 2.19</size></box></geometry>
        </collision>
        <visual name="vis">
          <geometry><box><size>0.05 0.95 2.19</size></box></geometry>
          <material><ambient>0.6 0.4 0.2 1</ambient><diffuse>0.6 0.4 0.2 1</diffuse></material>
        </visual>
        
        <visual name="entrance_door_knob_vis">
          <pose>0.03 0.95 0 0 1.5708 0</pose>
          <geometry><cylinder><radius>0.012</radius><length>0.10</length></cylinder></geometry>
          <material><ambient>0.8 0.8 0.2 1</ambient><diffuse>0.8 0.8 0.2 1</diffuse><specular>0.9 0.9 0.9 1</specular></material>
        </visual>
        <collision name="entrance_door_knob_col">
          <pose>0.03 0.95 0 0 1.5708 0</pose>
          <geometry><cylinder><radius>0.012</radius><length>0.10</length></cylinder></geometry>
        </collision>
        <inertial>
          <mass>8.0</mass>
          <inertia>
            <ixx>3.2</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>0.02</iyy><iyz>0</iyz>
            <izz>3.2</izz>
          </inertia>
        </inertial>
      </link>
      <joint name="door_hinge" type="revolute">
        <parent>door_frame</parent>
        <child>door_leaf</child>
        <pose>0 0 0 0 0 0</pose>
        <axis>
          <xyz>0 0 1</xyz>
          <limit><lower>0.0</lower><upper>1.5708</upper><effort>100</effort><velocity>1.0</velocity></limit>
          <dynamics><damping>3.0</damping><friction>1.5</friction></dynamics>
        </axis>
      </joint>
    </model>

